---
interface Props { title?: string; desc?: string }
const {
  title = '운동재활의 다음 기준을 함께 만들어 갈 분을 기다립니다',
  desc = '회원 유형을 확인하고 가입·문의를 남겨 주세요. 담당자가 확인 후 안내해 드립니다.',
} = Astro.props;
---
<section class="section section--tight">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2>{title}</h2>
        <p>{desc}</p>
      </div>
      <div class="actions">
        <a href="/apply/" class="btn btn--primary">회원 가입 · 문의</a>
        <a href="/membership/" class="btn btn--ghost">회원 유형 보기</a>
      </div>
    </div>
  </div>
</section>
