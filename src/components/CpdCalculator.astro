---
import { cpd } from '../data/education';
---
<div class="cpd" data-cpd data-target={cpd.target}>
  <div class="cpd__head">
    <div>
      <span class="tag">안(案) · 이사회 확정 전</span>
      <h3>평점(CPD) 계산기</h3>
      <p>{cpd.cycleYears}년 주기 동안 쌓은 활동을 입력하면 합산 평점과 목표 대비 달성률을 보여 줍니다.</p>
    </div>
  </div>
  <div class="cpd__rows">
    {cpd.rows.map((r) => (
      <div class="cpd__row">
        <label for={`cpd-${r.id}`}>
          <strong>{r.label}</strong>
          <small>{r.points}점 / {r.unit}</small>
        </label>
        <div class="cpd__stepper">
          <button type="button" data-dec aria-label={`${r.label} 줄이기`}>−</button>
          <input id={`cpd-${r.id}`} type="number" min="0" max="99" value="0" inputmode="numeric" data-points={r.points} />
          <button type="button" data-inc aria-label={`${r.label} 늘리기`}>+</button>
        </div>
        <span class="cpd__sub" data-sub>0점</span>
      </div>
    ))}
  </div>
  <div class="cpd__total">
    <div class="cpd__bar" aria-hidden="true"><i data-bar></i></div>
    <p><strong data-sum>0</strong>점 <span>/ 목표 {cpd.target}점 ({cpd.cycleYears}년)</span> <em data-msg></em></p>
  </div>
</div>

<style>
  .cpd { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 32px; }
  .cpd__head h3 { margin-top: 10px; font-size: 24px; font-weight: 800; color: var(--navy-900); }
  .cpd__head p { margin-top: 6px; color: var(--ink-2); font-size: 15px; }
  .cpd__rows { margin-top: 22px; display: flex; flex-direction: column; }
  .cpd__row { display: grid; grid-template-columns: 1fr auto 70px; gap: 16px; align-items: center; padding: 14px 0; border-top: 1px solid var(--line); }
  .cpd__row label strong { display: block; font-size: 15.5px; color: var(--ink); }
  .cpd__row label small { color: var(--ink-3); font-size: 13px; }
  .cpd__stepper { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
  .cpd__stepper button { width: 38px; height: 38px; border: 0; background: var(--bg-soft); font: inherit; font-size: 18px; font-weight: 700; color: var(--ink-2); cursor: pointer; }
  .cpd__stepper button:hover { background: var(--accent-50); color: var(--accent-600); }
  .cpd__stepper input { width: 52px; height: 38px; border: 0; text-align: center; font: inherit; font-size: 16px; font-weight: 700; color: var(--navy-900); -moz-appearance: textfield; }
  .cpd__stepper input::-webkit-outer-spin-button, .cpd__stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .cpd__stepper input:focus { outline: 2px solid var(--accent-600); outline-offset: -2px; }
  .cpd__sub { text-align: right; font-size: 14px; font-weight: 700; color: var(--accent-600); }
  .cpd__total { margin-top: 10px; padding-top: 22px; border-top: 2px solid var(--navy-900); }
  .cpd__bar { height: 12px; border-radius: 999px; background: #e9eef3; overflow: hidden; }
  .cpd__bar i { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, var(--teal-600), var(--accent-500)); transition: width .35s cubic-bezier(.2, .7, .2, 1); }
  .cpd__total p { margin-top: 14px; font-size: 15px; color: var(--ink-2); }
  .cpd__total strong { font-size: 32px; font-weight: 800; color: var(--navy-900); letter-spacing: -0.03em; }
  .cpd__total em { display: block; margin-top: 6px; font-style: normal; font-weight: 700; color: var(--teal-600); }
  @media (max-width: 600px) { .cpd { padding: 20px 16px; } .cpd__row { grid-template-columns: 1fr auto; } .cpd__sub { grid-column: 2; text-align: right; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cpd]').forEach((root) => {
    const target = Number(root.dataset.target) || 100;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-points]')];
    const sum = root.querySelector<HTMLElement>('[data-sum]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const msg = root.querySelector<HTMLElement>('[data-msg]')!;

    const clamp = (v: number) => Math.max(0, Math.min(99, Number.isFinite(v) ? Math.floor(v) : 0));
    const recalc = () => {
      let total = 0;
      inputs.forEach((inp) => {
        const n = clamp(Number(inp.value));
        const pts = n * Number(inp.dataset.points);
        total += pts;
        const sub = inp.closest('.cpd__row')?.querySelector<HTMLElement>('[data-sub]');
        if (sub) sub.textContent = `${pts}점`;
      });
      sum.textContent = String(total);
      bar.style.width = `${Math.min(100, (total / target) * 100)}%`;
      msg.textContent = total >= target ? '목표 평점을 충족했습니다.' : total > 0 ? `목표까지 ${target - total}점 남았습니다.` : '';
    };

    inputs.forEach((inp) => {
      inp.addEventListener('input', recalc);
      inp.addEventListener('blur', () => { inp.value = String(clamp(Number(inp.value))); recalc(); });
      const row = inp.closest('.cpd__row')!;
      row.querySelector('[data-dec]')?.addEventListener('click', () => { inp.value = String(clamp(Number(inp.value) - 1)); recalc(); });
      row.querySelector('[data-inc]')?.addEventListener('click', () => { inp.value = String(clamp(Number(inp.value) + 1)); recalc(); });
    });
    recalc();
  });
</script>
