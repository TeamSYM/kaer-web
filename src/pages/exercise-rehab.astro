---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import RtsExplorer from '../components/RtsExplorer.astro';
import RoleTable from '../components/RoleTable.astro';
import { competencies, rtsCitation } from '../data/framework';
---
<Base title="운동재활 프레임워크" description="평가에서 치료, 운동재활, 복귀까지 이어지는 운동재활의 연속체와 8개 전문 역량, 직종별 역할 구분을 정리한 대한운동재활학회의 프레임워크입니다.">
  <PageHero eyebrow="Exercise Rehabilitation" title="운동재활 프레임워크" desc="복귀 연속체, 8개 전문 역량, 직종별 역할 구분. 학회가 운동재활을 바라보는 기본 틀입니다." />

  <nav class="subnav">
    <div class="container">
      <a href="#continuum">복귀 연속체</a>
      <a href="#competency">전문 역량</a>
      <a href="#roles">역할 구분</a>
      <a href="#evidence">근거</a>
    </div>
  </nav>

  <section class="section" id="continuum">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Return-to-Sport Continuum</span>
        <h2 class="h-section">복귀는 한 번의 결정이 아니라 하나의 연속체입니다</h2>
        <p class="lead">
          손상 후 경기장으로 돌아가는 과정은 "참여 복귀 → 스포츠 복귀 → 퍼포먼스 복귀"로 이어지는 연속체로 이해합니다. 복귀는 재활이 끝난 뒤 내리는 단 한 번의 결정이 아니라, 재활과 나란히 진행되는 과정입니다.
        </p>
      </div>
      <RtsExplorer />
      <div class="two">
        <div class="note-box"><strong>이 도구를 쓰는 법.</strong> 단계를 고르고, 해당 기준이 확인된 항목에 체크해 보세요. 어느 영역이 비어 있는지 한눈에 볼 수 있습니다. 점수나 합격 여부를 내지 않으며, 복귀 판단 자체를 대신하지 않습니다.</div>
        <div class="note-box"><strong>왜 연속체인가.</strong> 의학적 회복, 기능, 심리, 경기 맥락은 단계마다 다른 비중으로 작용합니다. 한 가지 검사 결과나 정해진 날짜만으로 복귀를 정하지 않도록 돕는 것이 이 틀의 목적입니다.</div>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="competency">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Competency Framework</span>
        <h2 class="h-section">8개 전문 역량 영역</h2>
        <p class="lead">국내외 스포츠재활·스포츠물리치료 기준에서 공통으로 요구되는 영역을 학습해, 우리 현장의 언어로 정리했습니다. 교육과정과 평점 제도의 기준이 됩니다.</p>
      </div>
      <div class="grid grid-2 comps">
        {competencies.map((c, i) => (
          <article class="cp reveal" id={`c-${c.id}`}>
            <div class="cp__head">
              <div class="icon-badge"><Icon name={c.icon} /></div>
              <div><span class="cp__no">{String(i + 1).padStart(2, '0')}</span><h3>{c.title}</h3><small>{c.en}</small></div>
            </div>
            <p>{c.desc}</p>
            <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="roles">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Role Delineation</span>
        <h2 class="h-section">직종별 역할 구분</h2>
        <p class="lead">운동재활의 현장에는 여러 직종이 함께합니다. 누가 무엇을 주도하고 누가 협력하는지를 분명히 해야 안전하고 효과적인 협업이 가능합니다.</p>
      </div>
      <RoleTable />
    </div>
  </section>

  <section class="section section--soft" id="evidence">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Evidence</span>
        <h2 class="h-section">우리는 이렇게 근거를 씁니다</h2>
        <div class="prose" style="margin-top:28px">
          <p>학회의 교육과 자료는 공개된 합의문과 연구, 그리고 해외 직능단체의 공식 문서를 바탕으로 합니다. 출처가 확인되지 않는 효과나 수치는 쓰지 않으며, 근거가 부족하거나 논쟁이 있는 부분은 그렇다고 밝힙니다.</p>
          <p>복귀 연속체의 틀은 2016년 스포츠물리치료 세계 학술대회(Bern)에서 발표된 국제 합의문에 기반합니다.</p>
        </div>
      </div>
      <div class="reveal">
        <div class="cite">
          <span class="tag">핵심 참고문헌</span>
          <p>{rtsCitation.text}</p>
          <a href={rtsCitation.doi} target="_blank" rel="noopener noreferrer">원문 보기 <Icon name="external" size={15} /></a>
        </div>
        <p class="more"><a href="/resources/#benchmarks">학회가 참고한 국내외 기준 전체 보기 <Icon name="arrow" size={16} /></a></p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .two { margin-top: 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 800px) { .two { grid-template-columns: 1fr; } }

  .cp { padding: 30px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .cp__head { display: flex; gap: 16px; align-items: center; }
  .cp__head .icon-badge { margin: 0; flex-shrink: 0; }
  .cp__no { font-size: 12px; font-weight: 800; letter-spacing: .1em; color: var(--accent-600); }
  .cp h3 { font-size: 21px; font-weight: 800; color: var(--navy-900); line-height: 1.3; }
  .cp small { display: block; font-size: 12.5px; color: var(--ink-3); }
  .cp > p { margin-top: 18px; color: var(--ink-2); font-size: 15.5px; line-height: 1.75; }
  .cp ul { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .cp li { position: relative; padding-left: 20px; font-size: 14.5px; color: var(--ink-2); }
  .cp li::before { content: ''; position: absolute; left: 0; top: 10px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent-600); }

  .cite { padding: 28px; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); }
  .cite p { margin-top: 14px; font-size: 15px; color: var(--ink-2); line-height: 1.75; }
  .cite a { margin-top: 14px; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--accent-600); }
  .cite a:hover { text-decoration: underline; }
  .more { margin-top: 20px; font-weight: 700; }
  .more a { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-600); }
  .more a:hover { text-decoration: underline; }
</style>
