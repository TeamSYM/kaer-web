---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import CpdCalculator from '../components/CpdCalculator.astro';
import { tracks, levels, credentialNote, programStatus } from '../data/education';

const trackLabel = { both: '공통', A: '임상 트랙', B: '운동 · 컨디셔닝 트랙' } as const;
const steps = [
  { t: '가입', d: '회원 유형을 확인하고 가입 신청서를 제출합니다.' },
  { t: '교육 이수', d: '단계별 교육과정을 수강하고 과제와 평가를 마칩니다.' },
  { t: '평점 관리', d: '교육, 학술 활동, 연구로 평점(CPD)을 쌓고 기록합니다.' },
  { t: '인증 · 갱신', d: '일정한 주기마다 평점으로 전문성 유지를 확인합니다.' },
];
---
<Base title="교육 · 자격" description="기초 · 임상 · 복귀 · 전문의 네 단계로 구성한 대한운동재활학회의 교육 체계. 임상 트랙과 운동·컨디셔닝 트랙, 평점(CPD) 제도를 안내합니다.">
  <PageHero eyebrow="Education & Credential" title="교육 · 자격" desc="기초에서 전문까지 네 단계, 두 개의 트랙으로 운동재활의 전문성을 쌓습니다." />

  {programStatus === 'proposal' && (
    <div class="banner"><div class="container">{credentialNote}</div></div>
  )}

  <nav class="subnav">
    <div class="container">
      <a href="#tracks">두 개의 트랙</a>
      <a href="#levels">교육 단계</a>
      <a href="#flow">자격 흐름</a>
      <a href="#cpd">평점 계산기</a>
    </div>
  </nav>

  <section class="section" id="tracks">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Two Tracks</span>
        <h2 class="h-section">직종에 맞는 두 개의 트랙</h2>
        <p class="lead">같은 연속체를 다루되, 직종마다 맡는 영역이 다릅니다. 교육도 그 경계에 맞추어 두 개의 트랙으로 운영합니다.</p>
      </div>
      <div class="grid grid-2">
        {(['A', 'B'] as const).map((k) => (
          <article class={`trk reveal trk--${k}`}>
            <span class="trk__badge">TRACK {k}</span>
            <h3>{tracks[k].label}</h3>
            <p class="trk__who">{tracks[k].who}</p>
            <p>{tracks[k].desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft" id="levels">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Curriculum</span>
        <h2 class="h-section">네 단계의 교육 체계</h2>
      </div>
      <div class="lv">
        {levels.map((l) => (
          <article class="lv__item reveal">
            <div class="lv__side">
              <span class="lv__no">{l.no}</span>
              <h3>{l.title}</h3>
              <small>{l.en}</small>
              <p>{l.goal}</p>
              {l.hours ? <span class="tag">{l.hours}</span> : <span class="tag tag--line">시수 확정 후 안내</span>}
            </div>
            <ul class="lv__mods">
              {l.modules.map((m) => (
                <li>
                  <span>{m.name}</span>
                  <em class={`trkchip trkchip--${m.track}`}>{trackLabel[m.track]}</em>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="flow">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Credential Flow</span>
        <h2 class="h-section">자격 흐름</h2>
      </div>
      <ol class="flow">
        {steps.map((s, i) => (
          <li class="reveal"><span class="flow__no">{i + 1}</span><strong>{s.t}</strong><small>{s.d}</small></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft" id="cpd">
    <div class="container split split--wide-left">
      <div class="reveal">
        <span class="eyebrow">CPD</span>
        <h2 class="h-section">배움을 평점으로 기록합니다</h2>
        <div class="prose" style="margin-top:28px">
          <p>지속적 전문성 개발(CPD)은 자격을 얻은 뒤에도 교육, 학술 활동, 연구로 전문성을 키우고 기록하는 제도입니다. 해외 직능단체들도 일정한 주기마다 CPD 기준을 충족하도록 요구합니다.</p>
          <p>오른쪽 계산기로 내 활동이 평점으로 얼마나 환산되는지 미리 확인해 보세요. 기준은 이사회 확정 전의 안(案)입니다.</p>
        </div>
      </div>
      <div class="reveal"><CpdCalculator /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .banner { background: var(--accent-50); border-bottom: 1px solid var(--accent-100); }
  .banner .container { padding-top: 12px; padding-bottom: 12px; font-size: 14px; font-weight: 600; color: var(--accent-600); }

  .trk { padding: 32px; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); border-top: 5px solid var(--navy-900); }
  .trk--B { border-top-color: var(--accent-600); }
  .trk__badge { font-size: 12px; font-weight: 800; letter-spacing: .12em; color: var(--ink-3); }
  .trk h3 { margin-top: 8px; font-size: 24px; font-weight: 800; color: var(--navy-900); }
  .trk__who { margin-top: 6px !important; font-weight: 700; color: var(--accent-600) !important; }
  .trk p { color: var(--ink-2); margin-top: 12px; }

  .lv { display: flex; flex-direction: column; gap: 16px; }
  .lv__item { display: grid; grid-template-columns: 320px 1fr; gap: 32px; padding: 30px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .lv__no { font-size: 13px; font-weight: 800; letter-spacing: .1em; color: var(--accent-600); }
  .lv__side h3 { margin-top: 4px; font-size: 26px; font-weight: 800; color: var(--navy-900); }
  .lv__side small { display: block; font-size: 13px; color: var(--ink-3); }
  .lv__side p { margin: 12px 0 14px; color: var(--ink-2); font-size: 15px; line-height: 1.7; }
  .lv__mods { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; align-content: start; }
  .lv__mods li { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; border-radius: 12px; background: var(--bg-soft); font-weight: 600; font-size: 15px; color: var(--ink); }
  .trkchip { align-self: flex-start; font-style: normal; font-size: 11.5px; font-weight: 700; padding: 2px 9px; border-radius: 999px; }
  .trkchip--both { background: #e8eef6; color: var(--navy-700); }
  .trkchip--A { background: var(--navy-900); color: #fff; }
  .trkchip--B { background: var(--accent-600); color: #fff; }
  @media (max-width: 900px) { .lv__item { grid-template-columns: 1fr; gap: 20px; padding: 22px; } .lv__mods { grid-template-columns: 1fr; } }

  .flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .flow li { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 26px 24px; border-radius: var(--radius); border: 1px solid var(--line); background: #fff; }
  .flow li:not(:last-child)::after { content: ''; position: absolute; right: -13px; top: 50%; width: 10px; height: 10px; border-top: 2px solid var(--accent-600); border-right: 2px solid var(--accent-600); transform: translateY(-50%) rotate(45deg); }
  .flow__no { width: 32px; height: 32px; border-radius: 50%; background: var(--navy-900); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
  .flow strong { margin-top: 6px; font-size: 18px; color: var(--navy-900); }
  .flow small { font-size: 14px; color: var(--ink-2); line-height: 1.6; }
  .flow li:last-child { background: var(--navy-900); border-color: transparent; }
  .flow li:last-child strong { color: #fff; }
  .flow li:last-child small { color: rgba(255, 255, 255, .72); }
  .flow li:last-child .flow__no { background: var(--accent-600); }
  @media (max-width: 900px) { .flow { grid-template-columns: repeat(2, 1fr); } .flow li::after { display: none; } }
  @media (max-width: 560px) { .flow { grid-template-columns: 1fr; } }
</style>
