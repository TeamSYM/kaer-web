---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다" description="요청하신 페이지가 없거나 주소가 변경되었습니다. 홈페이지에서 필요한 정보를 확인해 주세요." noindex>
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>페이지를 찾을 수 없습니다</h1>
      <p>주소를 다시 확인하거나 홈페이지로 이동해 주세요.</p>
      <a class="btn btn--primary" href="/">홈으로 이동</a>
    </div>
  </section>
</Base>
