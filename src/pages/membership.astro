---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import MemberFinder from '../components/MemberFinder.astro';
import { members } from '../data/education';

const steps = [
  { t: '문의 · 신청', d: '가입 · 문의 양식으로 회원 유형과 연락처를 남깁니다.' },
  { t: '자격 확인', d: '면허, 재학, 소속 등 유형별 확인 서류를 안내해 드립니다.' },
  { t: '승인', d: '확인이 끝나면 회원 승인과 이용 안내를 드립니다.' },
  { t: '활동 시작', d: '교육, 학술 행사, 위원회 활동에 참여합니다.' },
];
---
<Base title="회원 안내" description="정회원, 준회원, 협력회원, 기관회원 등 대한운동재활학회의 회원 유형과 가입 절차를 안내합니다. 나에게 맞는 회원 유형도 찾아볼 수 있습니다.">
  <PageHero eyebrow="Membership" title="회원 안내" desc="직종과 목적에 맞는 회원 유형으로 학회의 교육과 학술 활동에 참여하세요." photo="msk-shoulder" />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Member Types</span>
        <h2 class="h-section">회원 유형</h2>
      </div>
      <div class="grid grid-4">
        {members.map((m) => (
          <article class:list={['mem', 'reveal', { 'mem--feat': m.featured }]}>
            <span class="mem__en">{m.en}</span>
            <h3>{m.title}</h3>
            <p class="mem__who">{m.who}</p>
            <ul>{m.can.map((c) => <li>{c}</li>)}</ul>
            {m.cannot && <p class="mem__cannot">{m.cannot}</p>}
          </article>
        ))}
      </div>
      <p class="fee">회비와 가입비는 확정 후 안내합니다. 문의 양식으로 남겨 주시면 확정되는 대로 연락드립니다.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Find Yours</span>
        <h2 class="h-section">어느 회원 유형이 맞을까요?</h2>
        <p class="lead" style="margin-top:20px">직종에 따라 참여할 수 있는 교육과 활동의 범위가 다릅니다. 해당하는 항목을 고르면 맞는 회원 유형과 가입 문의 링크를 보여 드립니다.</p>
      </div>
      <div class="reveal"><MemberFinder /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How to Join</span>
        <h2 class="h-section">가입 절차</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="reveal"><span class="steps__no">{i + 1}</span><strong>{s.t}</strong><small>{s.d}</small></li>
        ))}
      </ol>
      <div class="note-box" style="margin-top:32px"><strong>직무 범위 안내.</strong> 정회원은 물리치료사 면허를 가진 보건의료인입니다. 협력회원의 교육과 활동에는 의료행위에 해당하는 영역이 포함되지 않습니다. 직무의 범위는 관계 법령과 소속 기관의 규정을 따릅니다.</div>
    </div>
  </section>

  <CtaBand title="가입 문의를 남겨 주세요" desc="회원 유형과 연락처를 남기시면 담당자가 확인 후 안내해 드립니다." />
</Base>

<style>
  .mem { padding: 28px 24px; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); display: flex; flex-direction: column; }
  .mem--feat { background: linear-gradient(150deg, var(--accent-600), var(--navy-800)); color: #fff; border-color: transparent; }
  .mem__en { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-600); }
  .mem--feat .mem__en { color: var(--accent-300); }
  .mem h3 { margin-top: 8px; font-size: 26px; font-weight: 800; }
  .mem__who { margin-top: 10px; font-size: 14.5px; font-weight: 600; color: var(--ink-2); line-height: 1.6; }
  .mem--feat .mem__who { color: rgba(255, 255, 255, .85); }
  .mem ul { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .mem li { position: relative; padding-left: 16px; font-size: 14px; color: var(--ink-2); line-height: 1.6; }
  .mem--feat li { color: rgba(255, 255, 255, .85); }
  .mem li::before { content: ''; position: absolute; left: 0; top: 9px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-600); }
  .mem--feat li::before { background: var(--accent-300); }
  .mem__cannot { margin-top: 16px; padding: 10px 12px; border-radius: 10px; background: var(--bg-soft); font-size: 13px; color: var(--ink-2); line-height: 1.6; }
  .fee { margin-top: 24px; font-size: 14px; color: var(--ink-3); }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .steps li { display: flex; flex-direction: column; gap: 6px; padding: 26px 24px; border-radius: var(--radius); border: 1px solid var(--line); background: #fff; }
  .steps__no { width: 32px; height: 32px; border-radius: 50%; background: var(--navy-900); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
  .steps strong { margin-top: 6px; font-size: 18px; color: var(--navy-900); }
  .steps small { font-size: 14px; color: var(--ink-2); line-height: 1.6; }
  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
