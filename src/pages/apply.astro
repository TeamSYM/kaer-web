---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, inquiryTypes } from '../data/site';

const { contact } = site;
// 정적 호스팅(GitHub Pages)에는 신청서를 받을 서버(api/apply.php)가 없다. 그때는 양식을 잠그고 안내만 보인다.
const formEnabled = import.meta.env.PUBLIC_FORM_ENABLED !== 'false';
const steps = [
  { t: '양식 제출', d: '회원 유형과 연락처를 남겨 주세요.' },
  { t: '자격 확인', d: '유형별 확인 서류를 안내해 드립니다.' },
  { t: '승인 · 안내', d: '확인 후 회원 승인과 이용 방법을 안내합니다.' },
];
---
<Base title="회원 가입 · 문의" description="대한운동재활학회 회원 가입과 교육, 학술, 제휴 문의를 남겨 주세요. 회원 유형을 확인한 뒤 담당자가 연락드립니다.">
  <PageHero eyebrow="Join & Contact" title="회원 가입 · 문의" desc="회원 가입과 교육, 학술, 제휴에 관한 문의를 남겨 주세요." photo="care-hands" />

  <section class="section">
    <div class="container apply">
      <aside class="reveal">
        <span class="eyebrow">Process</span>
        <h2 class="h-section">가입은 이렇게 진행됩니다</h2>
        <ol class="guide">
          {steps.map((s) => <li><strong>{s.t}</strong><span>{s.d}</span></li>)}
        </ol>
        <div class="note-box">
          <strong>회원 유형이 궁금하다면</strong><br />
          <a href="/membership/" class="link">회원 안내와 유형 찾기 <Icon name="arrow" size={15} /></a>
        </div>
        {(contact.email || contact.phone) && (
          <div class="contact">
            {contact.email && <p><Icon name="mail" size={18} /> {contact.email}</p>}
            {contact.phone && <p>{contact.phone}</p>}
            {contact.hours && <small>{contact.hours}</small>}
          </div>
        )}
      </aside>

      <div class="apply__form reveal" id="contact">
        {!formEnabled && (
          <div class="form__closed" role="note">
            <strong>온라인 신청·문의는 준비 중입니다.</strong>
            <p>학회 사무국 연락처가 확정되면 이곳에서 바로 접수할 수 있도록 열겠습니다.</p>
          </div>
        )}
        <form class="form" action="/api/apply.php" method="post" data-form data-enabled={formEnabled ? "1" : "0"} novalidate>
          <fieldset disabled={!formEnabled} class="form__fields">
          <input type="hidden" name="type" value="apply" data-type-input />
          <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

          <div class="field">
            <label for="category">문의 유형<span class="req">*</span></label>
            <select id="category" name="category" data-category>
              {inquiryTypes.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div class="form__row">
            <div class="field">
              <label for="name">성함<span class="req">*</span></label>
              <input id="name" name="name" type="text" required autocomplete="name" maxlength="50" />
            </div>
            <div class="field">
              <label for="phone">전화번호<span class="req">*</span></label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="010-0000-0000" maxlength="20" />
            </div>
          </div>
          <div class="field">
            <label for="email">이메일<span class="req">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" maxlength="100" />
          </div>
          <div class="form__row">
            <div class="field">
              <label for="license">물리치료사 면허번호 (정회원 신청 시)</label>
              <input id="license" name="license" type="text" maxlength="30" inputmode="numeric" />
            </div>
            <div class="field">
              <label for="job">소속 · 근무처</label>
              <input id="job" name="job" type="text" maxlength="30" />
            </div>
          </div>
          <div class="field">
            <label for="message" data-msg-label>남기실 말씀 (선택)</label>
            <textarea id="message" name="message" maxlength="2000" placeholder="궁금하신 점이나 요청사항을 적어 주세요."></textarea>
          </div>
          <label class="check">
            <input type="checkbox" name="agree" value="1" required />
            <span><a href="/privacy/" target="_blank">개인정보 수집 및 이용</a>에 동의합니다. (필수)</span>
          </label>
          <p class="form__error" data-error role="alert" hidden></p>
          <button type="submit" class="btn btn--primary btn--block" data-submit>{formEnabled ? '제출하기' : '준비 중'}</button>
          </fieldset>
        </form>

        <div class="done" data-done hidden>
          <div class="done__icon" aria-hidden="true">✓</div>
          <h2>접수되었습니다</h2>
          <p>남겨 주신 연락처로 담당자가 확인 후 안내해 드리겠습니다.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const typeInput = form.querySelector<HTMLInputElement>('[data-type-input]')!;
  const cat = form.querySelector<HTMLSelectElement>('[data-category]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const errorEl = form.querySelector<HTMLElement>('[data-error]')!;
  const done = document.querySelector<HTMLElement>('[data-done]')!;
  const msg = form.querySelector<HTMLTextAreaElement>('#message')!;
  const msgLabel = form.querySelector<HTMLElement>('[data-msg-label]')!;

  const isApply = (v: string) => /^(정회원|준회원|협력회원|기관회원)/.test(v);
  const sync = () => {
    const apply = isApply(cat.value);
    typeInput.value = apply ? 'apply' : 'inquiry';
    msg.required = !apply;
    msgLabel.textContent = apply ? '남기실 말씀 (선택)' : '문의 내용';
  };
  cat.addEventListener('change', sync);

  // 회원 유형 찾기에서 넘어온 경우 미리 선택한다.
  const preset: Record<string, string> = { regular: '정회원 가입', associate: '준회원 가입', partner: '협력회원 가입', org: '기관회원 · 제휴' };
  const q = new URLSearchParams(location.search).get('type');
  if (q && preset[q]) cat.value = preset[q];
  sync();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form.dataset.enabled === '0') return;
    errorEl.hidden = true;
    if (!form.checkValidity()) {
      const first = form.querySelector<HTMLElement>(':invalid');
      errorEl.textContent = first?.getAttribute('type') === 'checkbox' ? '개인정보 수집 및 이용에 동의해 주세요.' : '필수 항목을 올바르게 입력해 주세요.';
      errorEl.hidden = false;
      first?.focus();
      return;
    }
    submit.disabled = true;
    submit.textContent = '제출 중…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || 'failed');
      form.hidden = true;
      done.hidden = false;
      done.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      errorEl.textContent = '제출 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요.';
      errorEl.hidden = false;
      submit.disabled = false;
      submit.textContent = '제출하기';
    }
  });
</script>

<style>
  .form__fields { border: 0; margin: 0; padding: 0; min-width: 0; display: contents; }
  .form__fields:disabled > * { opacity: .55; }
  .form__closed { margin: 0 0 20px; padding: 16px 18px; border: 1px solid var(--line, #dfe1e7); border-left: 4px solid currentColor; border-radius: 6px; background: #f7f8fb; }
  .form__closed p { margin: 6px 0 0; font-size: .95em; }
  .apply { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: start; }
  @media (max-width: 960px) { .apply { grid-template-columns: 1fr; gap: 48px; } }
  .guide { margin: 28px 0; padding: 0; list-style: none; counter-reset: g; display: flex; flex-direction: column; }
  .guide li { counter-increment: g; position: relative; padding: 0 0 24px 48px; display: flex; flex-direction: column; }
  .guide li::before { content: counter(g); position: absolute; left: 0; top: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--navy-900); color: #fff; font-size: 14px; font-weight: 700; display: grid; place-items: center; }
  .guide li:not(:last-child)::after { content: ''; position: absolute; left: 14px; top: 34px; bottom: 4px; width: 2px; background: var(--line); }
  .guide strong { font-size: 17px; }
  .guide span { color: var(--ink-2); font-size: 15px; }
  .link { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; font-weight: 700; color: var(--accent-600); }
  .link:hover { text-decoration: underline; }
  .contact { margin-top: 20px; display: flex; flex-direction: column; gap: 6px; color: var(--ink-2); }
  .contact p { display: flex; align-items: center; gap: 8px; }

  .apply__form { padding: 36px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow); }
  .form { display: flex; flex-direction: column; gap: 20px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .form__row { grid-template-columns: 1fr; } .apply__form { padding: 24px 18px; } }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form__error { color: #b42318; font-size: 14px; font-weight: 600; }
  .done { text-align: center; padding: 40px 12px; }
  .done__icon { width: 64px; height: 64px; margin: 0 auto 20px; border-radius: 50%; background: var(--teal-600); color: #fff; font-size: 30px; font-weight: 800; display: grid; place-items: center; }
  .done h2 { font-size: 26px; font-weight: 800; }
  .done p { margin-top: 10px; color: var(--ink-2); }
</style>
