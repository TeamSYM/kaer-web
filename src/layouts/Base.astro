---
import '../styles/global.css';
import { site, nav, parentLine } from '../data/site';

interface Crumb { name: string; url: string }
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const defaultDescription =
  '치료에서 복귀까지, 근거로 이어지는 운동재활. 근골격계 질환, 수술 후 재활, 스포츠 복귀를 잇는 교육, 연구, 학술 교류를 다루는 대한운동재활학회입니다.';

const {
  title,
  description = defaultDescription,
  image = '/img/og.jpg',
  type = 'website',
  crumbs,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const origin = new URL(Astro.site!).origin;
const abs = (u: string) => new URL(u, Astro.site).href;
const path = Astro.url.pathname;
const canonical = abs(path);

// 제목: 검색결과에서 잘리지 않도록 60자 안쪽으로 맞춘다.
const homeTitle = `${site.name} | 근거 기반 운동재활 학술단체`;
const suffixed = title ? `${title} | ${site.name}` : homeTitle;
const fullTitle = title && suffixed.length > 60 ? title.slice(0, 60) : suffixed;

const cleaned = description.replace(/\s+/g, ' ').trim();
const padded = cleaned.length < 60 ? `${cleaned} (${site.name})` : cleaned;
const metaDesc = padded.length > 160 ? `${padded.slice(0, 157)}…` : padded;

// 구조화 데이터(JSON-LD): 학회의 이름·주소·로고와 경로만 담는다.
const orgId = `${origin}/#organization`;
const trail: Crumb[] = crumbs ?? (path === '/' || !title ? [] : [{ name: title, url: path }]);
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: site.name,
    alternateName: [site.nameEn, site.short],
    url: `${origin}/`,
    logo: abs('/img/emblem.png'),
  },
  { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: site.name, inLanguage: 'ko-KR', publisher: { '@id': orgId } },
  ...(trail.length
    ? [{
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: '홈', url: '/' }, ...trail].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.url) })),
      }]
    : []),
  ...jsonLd,
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const { contact } = site;
const hasContact = !!(contact.email || contact.phone || contact.address);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/img/emblem.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b2340" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={abs(image)} />
    <script type="application/ld+json" set:html={ld} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <a class="skip" href="#main">본문 바로가기</a>
    <header class="header" data-header>
      <div class="container header__inner">
        <a href="/" class="brand" aria-label={`${site.name} 홈`}>
          <img src="/img/emblem.png" alt="" width="40" height="40" />
          <span class="brand__text">
            <strong>{site.name}</strong>
            <small>{site.nameEn}</small>
          </span>
        </a>
        <nav class="nav" aria-label="주 메뉴">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a href="/apply/" class="btn btn--primary btn--sm header__cta">회원 가입 · 문의</a>
        <button class="menu-btn" type="button" aria-label="메뉴 열기" aria-expanded="false" data-menu-btn>
          <span></span><span></span>
        </button>
      </div>
      <div class="mobile-nav" data-mobile-nav hidden>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/apply/" class="btn btn--primary">회원 가입 · 문의</a></li>
        </ul>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__grid">
        <div>
          <div class="brand brand--light">
            <img src="/img/emblem.png" alt="" width="40" height="40" />
            <span class="brand__text">
              <strong>{site.name}</strong>
              <small>{site.nameEn}</small>
            </span>
          </div>
          <p class="footer__desc">{parentLine}</p>
          <p class="footer__fine">본 사이트의 내용은 교육·학술 정보이며, 개별 진단과 치료를 대신하지 않습니다.</p>
        </div>
        <div>
          <h3>연락처</h3>
          {hasContact ? (
            <>
              {contact.address && <p>{contact.address}</p>}
              {contact.phone && <p>{contact.phone}</p>}
              {contact.email && <p>{contact.email}</p>}
              {contact.hours && <p class="footer__fine">{contact.hours}</p>}
            </>
          ) : (
            <p>문의는 <a href="/apply/" style="text-decoration:underline">문의 양식</a>으로 남겨 주세요.</p>
          )}
        </div>
        <div>
          <h3>바로가기</h3>
          <ul>
            <li><a href="/exercise-rehab/">운동재활 프레임워크</a></li>
            <li><a href="/partnership/">협력 · MOU</a></li>
            <li><a href="/education/">교육 · 자격</a></li>
            <li><a href="/membership/">회원 안내</a></li>
            <li><a href="/privacy/">개인정보 수집 및 이용</a></li>
            <li><a href="/credits/">이미지 출처</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer__bottom">
        <span>© {new Date().getFullYear()} Korean Academy of Exercise Rehabilitation. All rights reserved.</span>
      </div>
    </footer>

    <script>
      const header = document.querySelector('[data-header]');
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const mnav = document.querySelector<HTMLElement>('[data-mobile-nav]');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
        if (mnav) mnav.hidden = !open;
        document.body.classList.toggle('menu-open', open);
      });
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
<style is:global>
  .footer__fine { margin-top: 12px; font-size: 13px; color: rgba(255, 255, 255, .55); }
</style>
